# Bu dosyayı ".env" olarak kopyalayın ve değerleri doldurun.

# --- Veritabanı ---
# Yerel geliştirme için SQLite (kurulum gerektirmez):
DATABASE_URL=sqlite:///./nsosyal.db
# PostgreSQL için (canlı/rapor):
# DATABASE_URL=postgresql+psycopg2://kullanici:sifre@localhost:5432/nsosyal

# --- JWT / oturum ---
JWT_SECRET=lutfen-uzun-ve-rastgele-bir-deger-girin
JWT_EXPIRE_MINUTES=1440

# --- Google Gemini (görsel açıklama) ---
# Google AI Studio'dan alınan anahtar. Boş bırakılırsa sistem örnek (mock) metne düşer.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
